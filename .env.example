# Copy this file to .env and fill in your keys. NEVER commit .env.

# ---- Synthesizer: Google Gemini ----
# Get free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ---- Verifier: Groq (Llama 3.3 70B) ----
# Get free at https://console.groq.com (no credit card required)
GROQ_API_KEY=

# ---- PubMed (optional but recommended; 3 req/s without, 10 req/s with) ----
# Get free at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
NCBI_EMAIL=ashek4official@gmail.com

# ---- Backend config ----
LANCEDB_PATH=./data/lancedb
SIMILARITY_THRESHOLD=0.55
CONFIDENCE_THRESHOLD=0.75

# ---- Model choices (override if needed) ----
# gemini-2.5-flash-lite is the synthesizer sweet spot for this app: unlike
# gemini-2.5-flash it does not burn 500+ "thinking" tokens before answering,
# so short cited answers come through complete and deterministically.
SYNTHESIZER_MODEL=gemini-2.5-flash-lite
# Fallback if the primary is overloaded / hits 5xx after retries.
# Leave empty to disable fallback.
SYNTHESIZER_FALLBACK_MODEL=gemini-2.5-flash
VERIFIER_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Frontend config ----
NEXT_PUBLIC_API_URL=http://localhost:8000
